---
import { Image } from 'astro:assets'
import { render } from 'astro:content'
import Base from '../../../layouts/Base.astro'
import BlogTagList from '../../../components/BlogTagList.vue'
import TwrhCusdis from '../../../components/TwrhCusdis.astro'
import {
  excerptText,
  formatDate,
  lqip,
  ogCoverUrl,
  sortedPosts
} from '../../../lib/blog'

export async function getStaticPaths() {
  const posts = await sortedPosts()
  return posts.map((post) => ({
    params: { name: post.id },
    props: { post }
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
const created = post.data.created
// meta description 用文章摘要，過長時截斷
const description = excerptText(post).replace(/\s+/g, ' ').slice(0, 160)
const ogImage = await ogCoverUrl(post, Astro.site)
const placeholder = await lqip(post.data.cover)
---

<Base
  title={post.data.title}
  description={description}
  license="ccby"
  ogImage={ogImage}
  ogType="article"
  articleMeta={{
    publishedTime: created.toISOString(),
    author: post.data.author,
    tags: post.data.tags
  }}
>
  <main class="mx-auto w-full max-w-3xl px-4 pb-16">
    <article itemscope itemtype="http://schema.org/Article">
      {/* 封面是本頁 LCP：不 lazy、提高抓取優先權；內文 max-w-3xl 約 768px，給到 2x */}
      <div class="relative mt-8 overflow-hidden">
        <img
          class="absolute inset-0 h-full w-full scale-110 object-cover blur-lg"
          aria-hidden="true"
          alt=""
          src={placeholder}
        />
        <Image
          class="lqip relative w-full"
          itemprop="image"
          src={post.data.cover}
          widths={[768, 1536]}
          sizes="(min-width: 768px) 768px, 100vw"
          format="webp"
          loading="eager"
          fetchpriority="high"
          alt={post.data.title}
          onload="this.classList.add('is-loaded')"
        />
      </div>
      <h1 class="mt-6 font-serif text-3xl font-black" itemprop="name headline">
        {post.data.title}
      </h1>
      <div
        class="prose prose-neutral mt-6 max-w-none border-b border-rule pb-8"
        itemprop="articleBody"
      >
        <Content />
      </div>
      <div
        class="mt-4 flex flex-wrap justify-between gap-3 text-sm text-ink-soft"
      >
        <div class="flex gap-4">
          <span itemprop="author" itemscope itemtype="http://schema.org/Person"
            >✍️ <span itemprop="name">{post.data.author}</span></span
          >
          <time
            itemprop="datePublished dateModified"
            datetime={created.toISOString()}
            class="font-mono">{formatDate(created)}</time
          >
        </div>
        {
          post.data.tags.length > 0 && (
            <span>
              🏷️ <BlogTagList tags={post.data.tags} />
            </span>
          )
        }
      </div>
      <span itemprop="publisher" itemscope itemtype="https://schema.org/Organization">
        <meta itemprop="name" content="開放台灣民間租屋資料" />
      </span>
    </article>
    <TwrhCusdis pageTitle={post.data.title} />
  </main>
</Base>
