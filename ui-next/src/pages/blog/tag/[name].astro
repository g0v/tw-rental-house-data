---
import Base from '../../../layouts/Base.astro'
import BlogPostList from '../../../components/BlogPostList.vue'
import BlogTagList from '../../../components/BlogTagList.vue'
import { collectTags, sortedPosts, toCard } from '../../../lib/blog'

export async function getStaticPaths() {
  const posts = await sortedPosts()
  return collectTags(posts).map((tag) => ({
    params: { name: tag },
    props: {
      posts: posts.filter((post) => post.data.tags.includes(tag)),
      otherTags: collectTags(posts).filter((other) => other !== tag)
    }
  }))
}

const { name: tag } = Astro.params
const { posts, otherTags } = Astro.props
const cards = await Promise.all(posts.map(toCard))
---

<Base title={`包含 ${tag} 的貼文`} license="ccby">
  <main class="mx-auto w-full max-w-6xl px-4 pb-16">
    <div class="pt-10 pb-8 text-center">
      <h1 class="font-serif text-3xl font-black tracking-wide">
        <span class="text-ink-soft">包含</span>
        {tag}
        <span class="text-ink-soft">的貼文</span>
      </h1>
      <p class="mt-3 text-sm text-ink-soft">
        其他標籤：<BlogTagList tags={otherTags} />
      </p>
    </div>
    <BlogPostList posts={cards} />
  </main>
</Base>
