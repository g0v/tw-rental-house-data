# cp .env.example .env 後填入自己的值（.env 已 gitignore）
# 沒設的項目會用 settings.sample.py 內的預設值

# 591 對 Scrapy 預設 UA 回 403，請設一個真實瀏覽器 UA
# TWRH_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) ...

# rotating proxy（同時套用到 playwright），不設則不走 proxy
# TWRH_PROXY=http://localhost:8000

# 效能參數：預設是禮貌值，正式爬蟲環境再調高
# TWRH_AUTOTHROTTLE=1
# TWRH_DOWNLOAD_DELAY=1
# TWRH_CONCURRENT_REQUESTS=16

# 591 頁面 render 所需的 init script，值請自備、不可散佈
# TWRH_BROWSER_INIT_SCRIPT=window.__example__ = true;
