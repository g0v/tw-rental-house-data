# cp .env.example .env 後填入自己的值（.env 已 gitignore）
# 沒設的項目沿用 crawler/general_settings.py 的禮貌預設值

# 591 對 Scrapy 預設 UA 回 403；不設則不帶 UA（591 照常回應），要模擬瀏覽器再自行設定
# TWRH_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) ...

# rotating proxy，不設則不走 proxy
# TWRH_PROXY=http://localhost:8000

# 爬蟲主機的效能設定（預設為禮貌值）
# TWRH_ROBOTSTXT_OBEY=0
# TWRH_AUTOTHROTTLE=0
# TWRH_DOWNLOAD_DELAY=0
# TWRH_CONCURRENT_REQUESTS=50

# SENTRY_DSN=https://your.sentry/dsn

# Django 端（django/backend/settings.py 亦讀取本檔；真環境變數優先於本檔）
# Django 設定一律走 env（settings_local.py 已退場）；
# 設了 TWRH_DB_NAME 即改用 PostGIS，否則為 spatialite 預設（僅供離線測試）
# TWRH_DB_NAME=twrh2025
# TWRH_DB_USER=postgres
# TWRH_DB_PASSWORD=
# TWRH_DB_HOST=127.0.0.1
# TWRH_DB_PORT=5432
# TWRH_SECRET_KEY=
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# L-C skip 降頻：full＝全量 detail（預設）；diff＝list diff 種子＋synthts 合成
# TWRH_DETAIL_SEED_MODE=diff
# TWRH_DETAIL_REFRESH_DAYS=7

# 1-1 queue 狀態機：failed 重試上限（達上限轉 dead，預設 3）；
# 終結列滾動保留天數（queuefinalize 清理窗口，預設 90——開放問題 #8）
# TWRH_QUEUE_MAX_ATTEMPTS=3
# TWRH_QUEUE_RETENTION_DAYS=90
